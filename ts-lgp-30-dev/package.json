{
  "name": "lgp30",
  "version": "1.4.0",
  "main": "index.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WizardOfHaas/LGP-30.git"
  },
  "scripts": {
    "test": "tsx --tsconfig tsconfig.json src/index.ts",
    "build": "esbuild --bundle web-entry.ts --outdir=dist --sourcemap --platform=browser",
    "lint": "eslint",
    "cf:dev": "vite build && wrangler dev",
    "cf:deploy": "vite build && wrangler deploy",
    "vite:build": "vite build",
    "vite:dev": "vite",
    "vite:preview": "vite preview",
    "vite:serve-dist": "http-server dist",
    "vite:test": "vitest",
    "vite:coverage": "vitest run --coverage",
    "docs:clean": "rm -rf docs",
    "docs": "typedoc",
    "xprepublish": "vite build && typedoc"
  },
  "author": "Sean Haas",
  "license": "ISC",
  "description": "Sean's very own LGP-30 emulator!",
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@eslint/markdown": "^7.5.1",
    "@types/jquery": "^3.5.33",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.6",
    "@xterm/xterm": "^5.5.0",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "http-server": "^14.1.1",
    "jquery": "^3.7.1",
    "tsx": "^4.20.6",
    "typedoc": "^0.28.15",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^4.0.6",
    "wrangler": "^4.47.0"
  }
}
