{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lgp30",
	"compatibility_date": "2025-11-13",
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	}
}